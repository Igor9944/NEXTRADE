DB_HOST=localhost
DB_PORT=5432
DB_NAME=nextrade
DB_USER=nextrade
DB_PASSWORD=your_password_here
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:5000
AI_PROVIDER=local
AI_MODEL=nextrade-local-assistant
AI_API_URL=
AI_API_KEY=
DEFAULT_LANGUAGE=fr
SUPPORTED_LANGUAGES=fr,en,ar

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=

# Storage: local in development, s3 in production (S3-compatible not configured yet)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=
UPLOAD_MAX_BYTES=10485760
INVOICE_TAX_RATE=0
INVOICE_CURRENCY=XOF

# Payment — sandbox HMAC locally; stripe when keys exist (never commit secrets)
PAYMENT_PROVIDER=sandbox
PAYMENT_MODE=test
PAYMENT_BASE_URL=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=XOF

# Email — Mailpit in development (SMTP 1025, UI/API 8025)
MAIL_PROVIDER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=nextrade@localhost
